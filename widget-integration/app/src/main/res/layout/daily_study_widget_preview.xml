<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview (Android 12+). Mirrors DailyStudyWidget at 4×2, dark theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:text="היום יום  ·  ג׳ כסלו"
            android:textColor="#FFC5B8F5"
            android:fontFamily="@font/romm_vilna_regular"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="מההפרש בין הנהגת הבעל שם טוב להנהגת המגיד, כי הבעל שם טוב היה עסוק בנסיעות שונות, והמגיד ישב בביתו."
            android:fontFamily="@font/romm_vilna_regular"
            android:textColor="#FFF2F2F0"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1FFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView style="@style/DailyStudyWidgetPreviewButton" android:text="חומש" android:textColor="#FFF4F66A" />
        <TextView style="@style/DailyStudyWidgetPreviewButton" android:text="תהילים" android:textColor="#FF9FDEEF" />
        <TextView style="@style/DailyStudyWidgetPreviewButton" android:text="תניא" android:textColor="#FFF0A0DD" />
        <TextView style="@style/DailyStudyWidgetPreviewButton" android:text="רמב״ם" android:textColor="#FFFF873F" />
    </LinearLayout>
</LinearLayout>
